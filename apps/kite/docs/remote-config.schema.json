{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/agilsosa/kite/docs/remote-config.schema.json",
  "title": "Kite remote configuration",
  "description": "Full child-profile state returned by the endpoint configured in Ajustes de adultos > Sincronización.",
  "type": "object",
  "required": [
    "schemaVersion",
    "childName",
    "volumeCap",
    "allowedOrigins",
    "allowedApps"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1,
      "description": "Payload format version. Kite currently accepts only 1."
    },
    "revision": {
      "description": "Optional identifier for the server-side revision of this state.",
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        {
          "type": "number"
        }
      ]
    },
    "childName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40
    },
    "parentPin": {
      "type": "string",
      "pattern": "^[0-9]{4,8}$",
      "description": "Optional adult PIN. When present, a successful sync replaces the locally stored PIN. When omitted, the current PIN is kept."
    },
    "volumeCap": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "allowedOrigins": {
      "type": "array",
      "maxItems": 50,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^https://",
        "maxLength": 300
      }
    },
    "allowedApps": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "$ref": "#/$defs/app"
      }
    },
    "features": {
      "type": "object",
      "maxProperties": 50,
      "description": "Reserved for future features. Kite stores it but does not act on it yet.",
      "additionalProperties": true
    }
  },
  "additionalProperties": true,
  "$defs": {
    "app": {
      "type": "object",
      "required": ["name"],
      "description": "Each app must provide either `paths` or the legacy `path`. At sync time Kite resolves the entry for the operating system it is running on; if `paths` has no entry for that OS, `path` is used instead. The other-platform entries are optional, so one payload can serve Linux, Windows, and macOS kiosks.",
      "anyOf": [
        {
          "required": ["path"]
        },
        {
          "required": ["paths"]
        }
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,64}$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "icon": {
          "type": "string",
          "enum": [
            "puzzle",
            "gamepad",
            "book",
            "palette",
            "music",
            "film",
            "camera",
            "flask",
            "globe",
            "rocket",
            "cat",
            "bot",
            "trophy",
            "wrench",
            "star",
            "shapes",
            "sparkles",
            "compass",
            "folder"
          ]
        },
        "paths": {
          "type": "object",
          "description": "Executable path for each operating system. Kite reads only the key that matches the machine it runs on. Unknown keys are rejected.",
          "additionalProperties": false,
          "properties": {
            "linux": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000,
              "pattern": "^/"
            },
            "windows": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000,
              "pattern": "^(?:[A-Za-z]:[\\\\/]|\\\\\\\\|/)"
            },
            "macos": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000,
              "pattern": "^/"
            }
          }
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000,
          "description": "Legacy single executable path, kept as a fallback for older servers and single-platform profiles. Used only when `paths` has no entry for the current OS.",
          "pattern": "^(?:[A-Za-z]:[\\\\/]|\\\\\\\\|/)"
        },
        "args": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "type": "string",
            "maxLength": 200
          }
        }
      },
      "additionalProperties": false
    }
  }
}
