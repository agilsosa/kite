{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "kite-cloud",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-09",
  "observability": {
    "enabled": true,
  },
  "upload_source_maps": true,
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
}
