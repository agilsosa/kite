{
  "name": "kite",
  "productName": "kite",
  "version": "1.0.0",
  "private": true,
  "description": "Lanzador infantil bloqueado en modo kiosco para aplicaciones, sitios web, Wi-Fi y volumen.",
  "keywords": [],
  "license": "MIT",
  "author": "agil",
  "repository": {
    "type": "git",
    "url": "https://github.com/agilsosa/kite.git"
  },
  "main": ".vite/build/main.cjs",
  "scripts": {
    "start": "electron-forge start",
    "clean": "node -e \"require('node:fs').rmSync('.vite', { recursive: true, force: true })\"",
    "package": "npm run clean && electron-forge package",
    "make": "npm run clean && electron-forge make",
    "release": "npm run clean && electron-forge release",
    "lint": "oxlint && oxfmt --check",
    "lint:fix": "oxlint --fix && oxfmt --write",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@electron-forge/cli": "^8.0.1",
    "@electron-forge/maker-deb": "^8.0.1",
    "@electron-forge/maker-rpm": "^8.0.1",
    "@electron-forge/maker-squirrel": "^8.0.1",
    "@electron-forge/maker-zip": "^8.0.1",
    "@electron-forge/plugin-auto-unpack-natives": "^8.0.1",
    "@electron-forge/plugin-fuses": "^8.0.1",
    "@electron-forge/plugin-vite": "^8.0.1",
    "@electron-forge/publisher-github": "^8.0.1",
    "@electron/fuses": "^2.1.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/electron-squirrel-startup": "^1.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "electron": "45.1.0",
    "oxfmt": "^0.41.0",
    "oxlint": "^1.90.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.5"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "easy-volume": "^1.2.0",
    "electron-squirrel-startup": "^1.0.1",
    "electron-store": "^12.0.0",
    "lucide-react": "^1.64.0",
    "node-wifi": "^2.0.16",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "allowScripts": {
    "electron-winstaller": true
  }
}
