{
  "name": "kite-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Kite monorepo: the kiosk launcher and its Cloudflare control plane.",
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "clean": "turbo run clean",
    "kite": "npm run start --workspace=kite",
    "kite:package": "npm run package --workspace=kite",
    "kite:make": "npm run make --workspace=kite",
    "cloud": "npm run dev --workspace=kite-cloud",
    "cloud:deploy": "npm run deploy --workspace=kite-cloud"
  },
  "devDependencies": {
    "oxfmt": "^0.41.0",
    "oxlint": "^1.90.0",
    "turbo": "^2.11.10"
  },
  "allowScripts": {
    "electron": true,
    "electron-winstaller": true,
    "esbuild": true,
    "workerd": true
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "npm@12.2.1"
}
